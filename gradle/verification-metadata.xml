<?xml version="1.0" encoding="UTF-8"?>
<!--
    Gradle dependency verification (docs D-032) — for ONE artefact: Tesseract4Android, the OCR's engine.

    It is published on JitPack only, which BUILDS what it serves from a Git tag when first asked: nothing
    but this file says that the bytes the build receives today are the bytes reviewed on 2026-10-23. Its
    AAR and its Gradle module — the metadata Gradle reads, the POM being then never fetched — are pinned
    by SHA-256; a byte of them changed and the build fails ("Dependency verification failed"), it never
    enters the APK. Proved by sabotages (phase 5 report): one character of the AAR's hash changed, the
    build failed; the entry renamed, the build failed — the trust rule below does not cover it. Should
    JitPack serve no module one day, Gradle would read the POM, unlisted here: the build fails too.

    Every other artefact is TRUSTED (not verified): they come from Google's Maven and Maven Central,
    which never rebuild a published version, and pinning hundreds of them by hand would be a list
    nobody reviews. The trust rule excludes the `cz.adaptech` groups by a negative look-ahead, so a new
    artefact of theirs is refused until its hash is written here.

    The hashes: the SHA-256 that JitPack's own Gradle module lists for the AAR, checked against the AAR
    downloaded; that of the module as downloaded.
    https://jitpack.io/cz/adaptech/tesseract4android/tesseract4android/4.9.0/
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!cz[.]adaptech([.]|$)).*$" regex="true" reason="Google's Maven and Maven Central never rebuild a release; only JitPack's artefacts are pinned"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="cz.adaptech.tesseract4android" name="tesseract4android" version="4.9.0">
         <artifact name="tesseract4android-4.9.0.aar">
            <sha256 value="bce5d6413a1a5ae3d7240033fbbc851ba3217d0a08d9769400e17a077f42cb2a" origin="JitPack's module, checked against the download (2026-10-23)"/>
         </artifact>
         <artifact name="tesseract4android-4.9.0.module">
            <sha256 value="7ee10fa26c3682c9a63fc27e4574335a135004d771cf92215febde3fbdb6f78a" origin="Downloaded from JitPack (2026-10-23)"/>
         </artifact>
      </component>
   </components>
</verification-metadata>
