<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Stockage Android ≤ 12 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!--
        MANAGE_EXTERNAL_STORAGE (Android 11+, "Tous les fichiers") :
        REQUISE pour la fonction CŒUR de Read Files Tech : explorateur de
        fichiers universel capable de parcourir, lire et éditer n'importe
        quel fichier sur le stockage partagé (Documents, Download, dossiers
        utilisateur). Le Storage Access Framework (SAF) ne couvre pas
        l'usage "file manager généraliste" (pas de listing arbitraire,
        pas d'accès cross-folders fluide). Aucune lecture/écriture en
        arrière-plan : l'utilisateur reste explicitement aux commandes.
        Documenté dans PRIVACY.md §9.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Médias Android 13+ : preview images/videos/audio dans les viewers. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!--
        REQUEST_INSTALL_PACKAGES :
        permet à l'utilisateur d'installer une APK sideloadée tapée dans
        l'explorateur (sans repasser par le Files système).
        Trade-off connu : combinée à MANAGE_EXTERNAL_STORAGE, cette permission
        peut être classée par Google Play Protect comme signature potentielle
        de "dropper" sur certains terminaux (faux positif "app dangereuse"
        au sideload). L'app n'étant pas distribuée via Play Store
        (Files Tech = sideload par GitHub Releases), ce risque est accepté
        pour rendre l'expérience "explorateur de fichiers" complète.
        Le runtime check `canRequestPackageInstalls()` est requis avant
        l'appel d'install (Android 8+).
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- OCR : capture caméra -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        AUCUNE PERMISSION RÉSEAU, depuis la v2.15.3 — comme Notes Tech, Agenda Tech,
        App Manager Tech et SMS Tech. Décision de Patrice du 2026-10-10.

        Jusqu'à la v2.15.2, l'application déclarait INTERNET pour une seule requête
        sortante : la vérification de mise à jour (API GitHub, au lancement et depuis
        « À propos »). Elle a été retirée AVANT ces lignes, comme l'exigeait
        l'avertissement qui figurait ici (sans quoi l'échec réseau aurait été avalé
        en silence) : « À propos » ouvre désormais la page des versions dans le
        navigateur, qui est le seul à se connecter.

        Le retrait est explicite (`tools:node="remove"`), parce que ces deux
        permissions ne viennent pas que d'ici : le fusionneur les AJOUTAIT déjà avant
        la v2.15, via `com.google.android.datatransport:transport-backend-cct`
        qu'embarque Google ML Kit (vérifiable à l'`aapt dump permissions` de l'APK
        v2.14.0). Supprimer seulement les lignes `uses-permission` les laisserait
        revenir dans l'APK. Le contrôle de la CI (`tools/check-manifest-permissions.py`)
        lit le manifeste FUSIONNÉ de la variante release, pas ce fichier — à chaque
        push, et dans `release.yml` sur la build même qui est publiée.

        Ce qui reste et ne dépend pas de nous : le scanner de documents de ML Kit
        s'exécute dans les services Google Play, un autre processus, avec ses
        propres permissions. L'OCR utilise le modèle embarqué dans l'APK.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
        requestLegacyExternalStorage : n'a d'effet QUE sur Android 10 (API 29),
        où il désactive le scoped storage et rend l'explorateur réellement
        utilisable avec READ_EXTERNAL_STORAGE. Sans lui, l'app était une
        impasse sur toute la plage Android 7→10 que `minSdk 24` annonce
        pourtant supporter : `MANAGE_EXTERNAL_STORAGE` n'existe qu'à partir
        d'Android 11, donc le bandeau « autorisez tous les fichiers » ne
        disparaissait jamais et son bouton ouvrait un écran de réglages sans
        aucune option à activer. Constaté sur Galaxy S9 (Android 10) le
        2026-08-09 — ni l'audit ni deux relectures externes ne l'avaient vu,
        il fallait l'appareil.

        Ignoré par Android 11+, qui utilise MANAGE_EXTERNAL_STORAGE.
    -->
    <application
        android:label="Read Files Tech"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Quick Tiles (volet notification Android, API 24+) -->
        <service
            android:name=".ScannerTileService"
            android:exported="true"
            android:icon="@mipmap/launcher_icon"
            android:label="Scanner Files Tech"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".OcrTileService"
            android:exported="true"
            android:icon="@mipmap/launcher_icon"
            android:label="OCR Files Tech"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".VaultTileService"
            android:exported="true"
            android:icon="@mipmap/launcher_icon"
            android:label="Coffre Files Tech"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ML Kit : modèle OCR latin embarqué dans l'APK (pas de download runtime) -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <!--
            ZÉRO TÉLÉMÉTRIE — retrait du transport `datatransport` de Google.

            Google ML Kit, qui fournit l'OCR hors ligne, embarque
            `com.google.android.datatransport:transport-backend-cct`. Ce
            composant remonte à Google des métriques d'usage de la
            bibliothèque. Il ne transmet pas le contenu des documents, mais il
            transmet quelque chose, et ce quelque chose n'a jamais été demandé.

            Les trois déclarations ci-dessous sont celles qu'il ajoutait au
            manifeste fusionné (vérifiées lignes 386-400 de
            `build/app/intermediates/merged_manifest/release/…`) :

              TransportBackendDiscovery              — enregistre le backend CCT
              JobInfoSchedulerService                — planifie les envois (API 21+)
              AlarmManagerSchedulerBroadcastReceiver — idem, repli par alarme

            `tools:node="remove"` les retire du manifeste FINAL. Sans point
            d'entrée déclaré, Android ne peut ni lier le service ni délivrer la
            diffusion : le transport ne démarre pas.

            Ce que ça ne fait PAS : le code du transport reste dans l'APK.
            Retirer ces composants coupe l'émission, pas la présence du code.
            Depuis la v2.15.3, l'application n'a de toute façon plus aucune
            permission réseau (cf. plus haut) : même démarré, le transport ne
            pourrait rien envoyer.

            À VÉRIFIER SUR APPAREIL, et pas seulement sur le manifeste :
            l'OCR et le scanner doivent continuer de fonctionner. Un composant
            de télémétrie absent fait normalement échouer l'initialisation du
            transport en silence, sans toucher au pipeline de reconnaissance —
            mais « normalement » n'est pas une vérification.
        -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />
        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            tools:node="remove" />
        <receiver
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
            tools:node="remove" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Synchronisation avec PDF Tech (édition PDF) -->
        <package android:name="com.pdftech.pdf_tech" />
        <!-- Cloud apps : envoyer un fichier directement -->
        <package android:name="com.infomaniak.drive" />
        <package android:name="me.proton.android.drive" />
        <package android:name="com.google.android.apps.docs" />
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Découverte des apps capables d'ouvrir des fichiers de tout type -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
        </intent>
        <!-- url_launcher Android 11+ : sans ces queries, canLaunchUrl
             retourne false sur https/mailto (lien Apache, contact email…). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>
</manifest>
