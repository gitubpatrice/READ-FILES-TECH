<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The theme the manifest names is the LAUNCH theme: the splash screen of androidx.core:core-splashscreen
        (the platform's from Android 12, the same look below it), as Agenda Tech and App Manager Tech: the logo
        on white. MainActivity's installSplashScreen() then switches to postSplashScreenTheme, the app's window.

        The icon is @drawable/splash_icon, the launcher artwork inset into the circle the splash draws its icon
        in; that file says why and how much.
    -->
    <style name="Theme.ReadFilesTech" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.ReadFilesTech.Window</item>
    </style>

    <!-- The app's window: Compose draws everything else (ui/theme/Theme.kt). The window background is the
         scaffold colour, so nothing flashes between the splash and the first frame. -->
    <style name="Theme.ReadFilesTech.Window" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
    </style>
</resources>
