<?xml version="1.0" encoding="utf-8"?>
<!--
    The phase 2 exit criterion's entry point (docs D-008 and the port plan, phase 2), merged into the
    `debug` and `check` builds ONLY. A release never carries it: tools/check-manifest-shape.py allows
    no provider in the release manifest.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The storage permissions the check needs are the main manifest's since phase 3 (the explorer). -->
    <application>
        <!--
            `content call` from adb. android:permission covers query/insert/update/delete, never call():
            PortCheckProvider checks the caller's uid itself (shell or root).
        -->
        <provider
            android:name=".check.PortCheckProvider"
            android:authorities="${applicationId}.portcheck"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
