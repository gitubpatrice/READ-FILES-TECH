<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no app data in the cloud backup or in a device-to-device transfer. Same rules as the
     2.15.x: the app keeps an encrypted vault and holds MANAGE_EXTERNAL_STORAGE, so every domain is
     excluded, as defence in depth. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
